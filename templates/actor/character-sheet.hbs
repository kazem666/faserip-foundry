<div class="faserip-sheet">
  <header class="sheet-header">
    <img class="profile" src="{{actor.img}}" data-action="editImage" title="{{actor.name}}" alt="{{actor.name}}" />
    <div class="header-fields">
      <h1 class="hero-name"><input name="name" type="text" value="{{actor.name}}" placeholder="Hero Name" /></h1>
      <div class="identity-row">
        <label>Public <input name="system.identity.public" type="text" value="{{system.identity.public}}" /></label>
        <label>Secret <input name="system.identity.secret" type="text" value="{{system.identity.secret}}" /></label>
      </div>
      <div class="identity-row">
        <label>Origin
          <select name="system.identity.origin">
            {{#each origins as |o|}}
            <option value="{{o}}" {{#if (eq ../system.identity.origin o)}}selected{{/if}}>{{o}}</option>
            {{/each}}
          </select>
        </label>
        <label>Group <input name="system.identity.group" type="text" value="{{system.identity.group}}" /></label>
      </div>
      <div class="identity-row">
        <label class="check"><span>Secret ID</span><input type="checkbox" name="system.identity.secretId" {{#if system.identity.secretId}}checked{{/if}} /></label>
        <button type="button" data-action="generate">Generate Hero</button>
      </div>
    </div>
  </header>

  <section class="resource-row">
    <div class="stat-box health">
      <header>Health</header>
      <div class="stat-values">
        <input type="number" name="system.health.value" value="{{system.health.value}}" />
        <span>/</span><span class="max">{{system.health.max}}</span>
      </div>
      <button type="button" data-action="resetHealth">Reset</button>
    </div>
    <div class="stat-box karma">
      <header>Karma</header>
      <div class="stat-values">
        <input type="number" name="system.karma.value" value="{{system.karma.value}}" />
        <span>/</span><span class="max">{{system.karma.max}}</span>
      </div>
      <button type="button" data-action="resetKarma">Reset</button>
    </div>
    <div class="stat-box resources">
      <header>Resources</header>
      <select name="system.resources.rank">
        {{#each ranks as |r|}}
        <option value="{{r.id}}" {{#if (eq ../system.resources.rank r.id)}}selected{{/if}}>{{r.label}}</option>
        {{/each}}
      </select>
      <button type="button" data-action="rollResources">FEAT</button>
    </div>
    <div class="stat-box popularity">
      <header>Popularity</header>
      <label>Hero <input type="number" name="system.popularity.value" value="{{system.popularity.value}}" /></label>
      <label>Secret <input type="number" name="system.popularity.secret" value="{{system.popularity.secret}}" /></label>
    </div>
  </section>

  <section class="abilities">
    <h2>FASERIP</h2>
    <div class="ability-grid">
      {{#each abilities as |ab|}}
      <div class="ability-card">
        <button type="button" class="ability-roll" data-action="rollAbility" data-ability="{{ab.key}}">
          <span class="abbr">{{ab.abbr}}</span><span class="name">{{ab.label}}</span>
        </button>
        <select name="system.abilities.{{ab.key}}.rank">
          {{#each ../ranks as |r|}}
          <option value="{{r.id}}" {{#if (eq ab.rank r.id)}}selected{{/if}}>{{r.abbr}}</option>
          {{/each}}
        </select>
        <input type="number" name="system.abilities.{{ab.key}}.number" value="{{ab.number}}" min="0" />
      </div>
      {{/each}}
    </div>
  </section>

  <nav class="sheet-tabs tabs">
    <a class="item" data-action="sheetTab" data-tab="powers">Powers</a>
    <a class="item" data-action="sheetTab" data-tab="talents">Talents</a>
    <a class="item" data-action="sheetTab" data-tab="contacts">Contacts</a>
    <a class="item" data-action="sheetTab" data-tab="gear">Gear</a>
    <a class="item" data-action="sheetTab" data-tab="bio">Biography</a>
  </nav>

  <section class="sheet-body">
    <div class="tab active" data-tab="powers">
      <ol class="item-list">
        {{#each powers as |item|}}
        <li class="item" data-item-id="{{item.id}}">
          <span class="item-name">{{item.name}}</span>
          <span class="item-rank">{{item.rankLabel}}</span>
          <button type="button" data-action="rollItem">FEAT</button>
          <a data-action="itemEdit">edit</a>
          <a data-action="itemDelete">x</a>
        </li>
        {{/each}}
      </ol>
      <h3>Power Catalog</h3>
      {{#each powerCatalog as |group|}}
      <details class="catalog">
        <summary>{{group.label}}</summary>
        {{#each group.items as |name|}}
        <button type="button" class="catalog-add" data-action="catalogAdd" data-type="power" data-name="{{name}}" data-category="{{group.label}}">{{name}}</button>
        {{/each}}
      </details>
      {{/each}}
    </div>

    <div class="tab" data-tab="talents">
      <ol class="item-list">
        {{#each talents as |item|}}
        <li class="item" data-item-id="{{item.id}}">
          <span class="item-name">{{item.name}}</span>
          <span class="item-rank">{{item.category}}</span>
          <a data-action="itemEdit">edit</a>
          <a data-action="itemDelete">x</a>
        </li>
        {{/each}}
      </ol>
      <h3>Talent Catalog</h3>
      {{#each talentCatalog as |group|}}
      <details class="catalog">
        <summary>{{group.label}}</summary>
        {{#each group.items as |name|}}
        <button type="button" class="catalog-add" data-action="catalogAdd" data-type="talent" data-name="{{name}}" data-category="{{group.label}}">{{name}}</button>
        {{/each}}
      </details>
      {{/each}}
    </div>

    <div class="tab" data-tab="contacts">
      <ol class="item-list">
        {{#each contacts as |item|}}
        <li class="item" data-item-id="{{item.id}}">
          <span class="item-name">{{item.name}}</span>
          <span class="item-rank">{{item.category}}</span>
          <a data-action="itemEdit">edit</a>
          <a data-action="itemDelete">x</a>
        </li>
        {{/each}}
      </ol>
      <h3>Contact Types</h3>
      {{#each contactCatalog as |name|}}
      <button type="button" class="catalog-add" data-action="catalogAdd" data-type="contact" data-name="{{name}}" data-category="{{name}}">{{name}}</button>
      {{/each}}
    </div>

    <div class="tab" data-tab="gear">
      <ol class="item-list">
        {{#each gear as |item|}}
        <li class="item" data-item-id="{{item.id}}">
          <span class="item-name">{{item.name}}</span>
          <button type="button" data-action="rollItem">FEAT</button>
          <a data-action="itemEdit">edit</a>
          <a data-action="itemDelete">x</a>
        </li>
        {{/each}}
      </ol>
      <button type="button" class="create" data-action="itemCreate" data-type="weapon">+ Weapon</button>
      <button type="button" class="create" data-action="itemCreate" data-type="equipment">+ Equipment</button>
    </div>

    <div class="tab" data-tab="bio">
      <h3>Biography</h3>
      {{editor enrichedBiography target="system.biography" button=true editable=editable engine="prosemirror"}}
      <h3>Notes</h3>
      {{editor enrichedNotes target="system.notes" button=true editable=editable engine="prosemirror"}}
    </div>
  </section>
</div>
