<div class="faserip-chat color-{{color}}">
  <header>
    <span class="feat-label">{{label}}</span>
    <span class="result-chip {{color}}{{#if fantastic}} fantastic{{/if}}">{{colorLabel}}</span>
    {{#if actorName}}<span class="who">{{actorName}}</span>{{/if}}
  </header>
  {{#if effect}}
  <div class="effect-banner">{{effectLabel}}: <strong>{{effect}}</strong></div>
  {{/if}}
  {{#if intensityId}}
  <p class="intensity {{#if intensityPass}}pass{{else}}fail{{/if}}">
    Intensity {{intensityLabel}} — {{intensityNeed}}
    {{#if intensityPass}} · SUCCESS{{else}} · FAIL{{/if}}
  </p>
  {{/if}}
  {{#if damageLine}}
  <section class="feat-damage{{#if damageApplied}} is-applied{{/if}}">{{damageLine}}</section>
  {{/if}}
  <div class="feat-facts">
    <span>d100 {{raw}}{{#if showAdjusted}}{{#if karma}} +{{karma}}{{/if}}{{#if combatFlat}}{{#if (gt combatFlat 0)}} +{{else}} {{/if}}{{combatFlat}}{{/if}} = {{adjusted}}{{/if}}</span>
    <span>{{baseRank}}{{#if cs}} {{#if (gt cs 0)}}+{{/if}}{{cs}} CS → {{effectiveRank}}{{/if}}</span>
    {{#if targetName}}<button type="button" class="target-pill" data-faserip-pan title="Pan to {{targetName}}">{{targetName}}</button>{{/if}}
  </div>
  <details class="feat-explain">
    <summary>Why this is {{colorLabel}}</summary>
    <ul>
      {{#each formulaLines}}<li>{{this}}</li>{{/each}}
    </ul>
  </details>
  {{#if shiftLines.length}}
  <details class="feat-explain">
    <summary>Where the column shift came from</summary>
    <ul>
      {{#each shiftLines}}<li>{{this}}</li>{{/each}}
    </ul>
  </details>
  {{/if}}
  <div class="feat-actions">
    {{#if showButtons}}
    {{#if psycheGate}}<button type="button" data-faserip-psyche>Psyche FEAT</button>{{/if}}
    {{#if canDamage}}<button type="button" data-faserip-apply>Apply {{damageAmount}}{{#if damageEnergy}} energy{{/if}}{{#if targetName}} to {{targetName}}{{/if}}</button>{{/if}}
    {{#if checkColumn}}<button type="button" data-faserip-check>{{checkLabel}}</button>{{/if}}
    {{/if}}
    {{#if fantastic}}
    <button type="button" data-faserip-panel>Describe the panel</button>
    <button type="button" data-faserip-free-stunt>Free Power Stunt</button>
    {{/if}}
    {{#if houseFocus}}<button type="button" data-faserip-focus-reroll>Reroll (1 Focus)</button>{{/if}}
    {{#if rollWithBlow}}<button type="button" data-faserip-rollblow>Roll with the blow</button>{{/if}}
    {{#if enduranceSoak}}<button type="button" data-faserip-soak>Soak with Endurance</button>{{/if}}
    {{#if boneBreak}}<button type="button" data-faserip-bone>Check for a break</button>{{/if}}
  </div>
</div>
