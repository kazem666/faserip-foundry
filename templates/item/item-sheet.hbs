<div class="faserip-item-sheet {{cssClass}}">
  <header class="sheet-header">
    <img src="{{item.img}}" data-edit="img" title="{{displayName}}" alt="{{displayName}}" />
    <div class="header-fields">
      {{#if veiled}}
      <h1>Unknown</h1>
      {{else}}
      <h1><input name="name" type="text" value="{{item.name}}" placeholder="Name" /></h1>
      {{/if}}
      <div class="item-type">{{item.type}}</div>
    </div>
  </header>

  {{#if veiled}}
  <p class="hint">A Reason FEAT reveals this. Magic Detection is used when that rank is higher.</p>
  <button type="button" data-action="identifyItem">Identify</button>
  {{else}}

  {{#if showVeilToggle}}
  <div class="form-group checks">
    <label class="check"><input type="checkbox" name="system.unknown" {{#if system.unknown}}checked{{/if}} /> Unknown until a Reason or Magic Detection FEAT</label>
  </div>
  {{/if}}

  <div class="form-group">
    <label>Rank</label>
    <select name="system.rank">
      {{#each ranks as |r|}}
      <option value="{{r.id}}" {{#if (eq ../system.rank r.id)}}selected{{/if}}>{{r.label}} ({{r.min}}–{{r.max}}, std {{r.value}})</option>
      {{/each}}
    </select>
  </div>

  <div class="form-group">
    <label>Rank Number (0 = standard)</label>
    <input type="number" name="system.number" value="{{system.number}}" min="0" />
  </div>

  <div class="form-group">
    <label>Category</label>
    <input name="system.category" type="text" value="{{system.category}}" />
  </div>

  {{#if isPower}}
  <div class="form-group">
    <label>Type</label>
    <input name="system.powerType" type="text" value="{{system.powerType}}" />
  </div>
  <div class="form-group">
    <label>Slots taken</label>
    <input type="number" name="system.slotsTaken" value="{{system.slotsTaken}}" min="0" max="2" />
  </div>
  <div class="form-group">
    <label>Range</label>
    <input name="system.range" type="text" value="{{system.range}}" />
  </div>
  <div class="form-group">
    <label>Area</label>
    <input name="system.area" type="text" value="{{system.area}}" />
  </div>
  <div class="form-group">
    <label>Acceleration / MPH / MPM / Areas per round</label>
    <div class="identity-row">
      <input name="system.acceleration" type="text" value="{{system.acceleration}}" placeholder="Accel" />
      <input name="system.mph" type="text" value="{{system.mph}}" placeholder="MPH" />
      <input name="system.mpm" type="text" value="{{system.mpm}}" placeholder="MPM" />
      <input name="system.areasPerRound" type="text" value="{{system.areasPerRound}}" placeholder="Areas/rd" />
    </div>
  </div>
  <div class="form-group">
    <label>Power emanates from</label>
    <input name="system.emanatesFrom" type="text" value="{{system.emanatesFrom}}" />
  </div>
  <div class="form-group">
    <label>Definition</label>
    <textarea name="system.definition" rows="3">{{system.definition}}</textarea>
  </div>
  <div class="form-group">
    <label>Limitation</label>
    <input name="system.limitation" type="text" value="{{system.limitation}}" />
  </div>
  <div class="form-group checks">
    <label class="check"><input type="checkbox" name="system.bodyArmor" {{#if system.bodyArmor}}checked{{/if}} /> Counts as Body Armor</label>
    <label class="check"><input type="checkbox" name="system.forceField" {{#if system.forceField}}checked{{/if}} /> Counts as Force Field</label>
  </div>
  <fieldset class="activity-line">
    <legend>On a success</legend>
    <p class="hint">Runs after a FEAT that is not white, when this power has no built-in use. A named power keeps its own behavior.</p>
    <label class="check"><input type="checkbox" name="system.activity.on" {{#if system.activity.on}}checked{{/if}} /> Use this success line</label>
    <div class="form-group">
      <label>Column shift</label>
      <input type="number" name="system.activity.shift" value="{{system.activity.shift}}" step="1" />
    </div>
    <div class="form-group">
      <label>Shift lands on</label>
      <select name="system.activity.shiftWho">
        <option value="self" {{#if (eq system.activity.shiftWho "self")}}selected{{/if}}>The user's next roll</option>
        <option value="foe" {{#if (eq system.activity.shiftWho "foe")}}selected{{/if}}>The next attack against the target</option>
      </select>
    </div>
    <div class="form-group">
      <label>Condition</label>
      <select name="system.activity.condition">
        {{#each conditions as |row|}}
        <option value="{{row.id}}" {{#if (eq ../system.activity.condition row.id)}}selected{{/if}}>{{row.label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="form-group">
      <label>Condition rounds (0 stays until removed)</label>
      <input type="number" name="system.activity.rounds" value="{{system.activity.rounds}}" min="0" step="1" />
    </div>
    <div class="form-group">
      <label>Area</label>
      <select name="system.activity.template">
        <option value="" {{#if (eq system.activity.template "")}}selected{{/if}}>None</option>
        <option value="circle" {{#if (eq system.activity.template "circle")}}selected{{/if}}>Circle</option>
      </select>
    </div>
    <div class="form-group">
      <label>Circle width in areas</label>
      <input type="number" name="system.activity.areas" value="{{system.activity.areas}}" min="0" step="1" />
    </div>
    <div class="form-group">
      <label>Health (positive restores, negative harms)</label>
      <input type="number" name="system.activity.health" value="{{system.activity.health}}" step="1" />
    </div>
  </fieldset>
  {{/if}}

  {{#if isTalent}}
  <div class="form-group">
    <label>Talent bonus</label>
    <input name="system.bonus" type="text" value="{{system.bonus}}" />
  </div>
  <div class="form-group">
    <label>Attribute application</label>
    <input name="system.attribute" type="text" value="{{system.attribute}}" />
  </div>
  <div class="form-group">
    <label>Slots taken</label>
    <input type="number" name="system.slotsTaken" value="{{system.slotsTaken}}" min="0" />
  </div>
  <div class="form-group">
    <label>Definition</label>
    <textarea name="system.definition" rows="3">{{system.definition}}</textarea>
  </div>
  {{/if}}

  {{#if isContact}}
  <div class="form-group">
    <label>Occupation</label>
    <input name="system.occupation" type="text" value="{{system.occupation}}" />
  </div>
  <div class="form-group">
    <label>Base of operations</label>
    <input name="system.base" type="text" value="{{system.base}}" />
  </div>
  <div class="form-group">
    <label>Tie to character</label>
    <input name="system.tie" type="text" value="{{system.tie}}" />
  </div>
  <div class="form-group">
    <label>Contact's practicality</label>
    <input name="system.practicality" type="text" value="{{system.practicality}}" />
  </div>
  <div class="form-group">
    <label>Assistance requested (0–10)</label>
    <input type="number" name="system.assistance" value="{{system.assistance}}" min="0" max="10" />
  </div>
  <div class="form-group">
    <label class="check"><input type="checkbox" name="system.acquired" {{#if system.acquired}}checked{{/if}} /> Contact acquired</label>
  </div>
  {{/if}}

  {{#if isEquipment}}
  <div class="form-group">
    <label>Material Strength</label>
    <select name="system.material">
      {{#each ranks as |r|}}
      <option value="{{r.id}}" {{#if (eq ../system.material r.id)}}selected{{/if}}>{{r.label}} ({{r.value}})</option>
      {{/each}}
    </select>
  </div>
  {{/if}}

  {{#if isEquipment}}
  {{#unless isWeapon}}
  <div class="form-group">
    <label class="check"><input type="checkbox" name="system.bodyArmor" {{#if system.bodyArmor}}checked{{/if}} /> Counts as Body Armor</label>
  </div>
  {{/unless}}
  {{/if}}

  {{#if spareAmmo}}
  <div class="form-group">
    <label>Rounds left</label>
    <input type="number" name="system.rounds" value="{{roundsLeft}}" min="0" />
  </div>
  {{/if}}

  {{#if chargeAuto}}
  <div class="form-group">
    <label class="check"><input type="checkbox" name="system.chargeOff" {{#if system.chargeOff}}checked{{/if}} /> Do not count uses</label>
  </div>
  {{else}}
  {{#unless tracksAmmo}}
  {{#unless spareAmmo}}
  {{#if isEquipment}}
  <div class="form-group">
    <label class="check"><input type="checkbox" name="system.expendable" {{#if system.expendable}}checked{{/if}} /> Count uses</label>
  </div>
  {{/if}}
  {{/unless}}
  {{/unless}}
  {{/if}}
  {{#if tracksCharges}}
  <div class="form-group">
    <label>Uses left</label>
    <input type="number" name="{{chargeField}}" value="{{chargesLeft}}" min="0" />
  </div>
  <p class="hint">One use spends one. A first aid kit refills from a medkit refill. Zero means it is used up.</p>
  {{/if}}

  {{#if isWeapon}}
  <div class="form-group">
    <label>Type</label>
    <input name="system.weaponType" type="text" value="{{system.weaponType}}" placeholder="Blunt, Edged, Shooting…" />
  </div>
  <div class="form-group">
    <label>Battle Effects column</label>
    <select name="system.effectsColumn">
      <option value="">— none —</option>
      {{#each columns as |c|}}
      <option value="{{c.id}}" {{#if (eq ../system.effectsColumn c.id)}}selected{{/if}}>{{c.label}}</option>
      {{/each}}
    </select>
  </div>
  <div class="form-group">
    <label>Range</label>
    <input name="system.range" type="text" value="{{system.range}}" />
  </div>
  <div class="form-group">
    <label>Damage</label>
    <input name="system.damage" type="text" value="{{system.damage}}" placeholder="Usually a rank number" />
  </div>
  {{#if ammoAuto}}
  <div class="form-group">
    <label class="check"><input type="checkbox" name="system.ammoOff" {{#if system.ammoOff}}checked{{/if}} /> Do not count shots</label>
  </div>
  {{else}}
  <div class="form-group">
    <label class="check"><input type="checkbox" name="system.usesAmmo" {{#if system.usesAmmo}}checked{{/if}} /> Count shots</label>
  </div>
  {{/if}}
  {{#if tracksAmmo}}
  <div class="form-group">
    <label>Shots left</label>
    <input type="number" name="system.shots" value="{{ammo.shots}}" min="0" />
  </div>
  <div class="form-group">
    <label>Magazine</label>
    <input type="number" name="system.capacity" value="{{ammo.capacity}}" min="1" />
  </div>
  <button type="button" data-action="reloadWeapon">Reload from ammunition</button>
  <p class="hint">One attack spends one shot. Reload draws from matching ammunition on the hero. A saved 0 on that ammunition means the stack is empty.</p>
  {{/if}}
  {{/if}}

  <div class="form-group stacked">
    <label>Notes</label>
    <textarea name="system.notes" rows="4">{{system.notes}}</textarea>
  </div>
  {{/if}}
</div>
